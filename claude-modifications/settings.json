{
    "permissions": {
        "allow": [
            "Read(${PWD}/**)",
            "Edit(${PWD}/**)",
            "Write(${PWD}/**)",
            "Glob(${PWD}/**)",
            "Grep(${PWD}/**)",
            "Bash(git:*)"
        ],
        "deny": [
            "Read(${PWD}/.env)",
            "Read(${PWD}/.env.*)",
            "Read(${PWD}/secrets/**)",
            "Bash(rm -rf:*)",
            "Bash(sudo:*)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": true,
        "allowUnsandboxedCommands": false
    }
}
